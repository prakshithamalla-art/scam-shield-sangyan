# Comma-separated list of allowed frontend origins ("*" for hackathon demo only)
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.netlify.app
# Max characters accepted per message
MAX_TEXT_LENGTH=5000
# Optional: future LLM / threat-intel keys (not required for the rule-based engine)
# SAFE_BROWSING_API_KEY=
PORT=8000

# --- Screenshot / OCR (Feature 5) ---
# Windows example (leave unset on Linux/macOS if `tesseract` is on PATH):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Languages must be installed (Hindi = hin, Telugu = tel). Missing ones are skipped automatically.
OCR_LANGS=eng+hin+tel
MAX_IMAGE_MB=5
OCR_TIMEOUT=25
